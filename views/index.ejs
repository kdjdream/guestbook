<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Node.js 방명록</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="container">
    <h1>📝 방명록</h1>

    <section class="write-box">
      <h2>방명록 작성</h2>

      <form action="/guestbook" method="post">
        <label for="name">이름</label>
        <input
          type="text"
          id="name"
          name="name"
          maxlength="50"
          required
          placeholder="이름을 입력하세요"
        >

        <label for="message">내용</label>
        <textarea
          id="message"
          name="message"
          maxlength="500"
          required
          placeholder="방명록 내용을 입력하세요"
        ></textarea>

        <button type="submit">등록하기</button>
      </form>
    </section>

    <section class="list-box">
      <h2>방명록 목록</h2>

      <div id="guestbook-list" data-version="<%= rows.map(function(row) { return row.id; }).join(",") %>">
        <% if (rows.length === 0) { %>
          <p class="empty">아직 등록된 방명록이 없습니다.</p>
        <% } %>

        <% rows.forEach(function(row) { %>
          <article class="guestbook-item">
            <div class="item-header">
              <strong><%= row.name %></strong>
              <span><%= new Date(row.created_at).toLocaleString("ko-KR") %></span>
            </div>
            <p><%= row.message %></p>
          </article>
        <% }) %>
      </div>
    </section>
  </main>
  <script>
    const list = document.getElementById("guestbook-list");

    function renderRows(rows) {
      const fragment = document.createDocumentFragment();

      if (rows.length === 0) {
        const empty = document.createElement("p");
        empty.className = "empty";
        empty.textContent = "아직 등록된 방명록이 없습니다.";
        fragment.append(empty);
      }

      rows.forEach((row) => {
        const item = document.createElement("article");
        item.className = "guestbook-item";

        const header = document.createElement("div");
        header.className = "item-header";
        const name = document.createElement("strong");
        name.textContent = row.name;
        const date = document.createElement("span");
        date.textContent = new Date(row.created_at).toLocaleString("ko-KR");
        const message = document.createElement("p");
        message.textContent = row.message;

        header.append(name, date);
        item.append(header, message);
        fragment.append(item);
      });

      list.replaceChildren(fragment);
    }

    async function refreshGuestbook() {
      try {
        const response = await fetch("/api/guestbook", { cache: "no-store" });
        if (!response.ok) return;

        const rows = await response.json();
        const version = rows.map((row) => row.id).join(",");
        if (version === list.dataset.version) return;

        renderRows(rows);
        list.dataset.version = version;
      } catch (error) {
        console.error("방명록 자동 갱신 오류:", error);
      }
    }

    window.setInterval(refreshGuestbook, 5000);
  </script>
</body>
</html>
